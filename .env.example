# Copy to .env (git-ignored) and fill in. Docker Compose reads it automatically.
# Nothing here is a secret on its own: the Firebase values are public web-app config.

# Port the web app is served on (http://localhost:8080 by default).
APP_PORT=8080

# Time zone for the daily scan and closing reminders.
TZ=Europe/London

# Firebase Authentication (Google sign-in). Create a web app in the Firebase console.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Google account that becomes the admin on first start, and the owner of pre-existing data.
INITIAL_ADMIN_EMAIL=
LEGACY_OWNER_EMAIL=

# Backend log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
