DATABASE_URL="file:./dev.db"

# Firebase Authentication public web-app configuration (Google provider enabled).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Verified Google email for the initial admin and the legacy CV/application owner.
INITIAL_ADMIN_EMAIL=
LEGACY_OWNER_EMAIL=

# Log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
